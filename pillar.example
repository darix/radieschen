redis:
  # optional redis|valkey
  # redis_implementation: redis
  instances:
    # this will remove an instance with all pieces but the datadir
    default:
      enable: False
    discourse:
      config:
        port: 6379
    forgejo:
      require_in:
        - forgejo_service
      require:
        - step_generic_host_cert
      config:
        port: 6380
        dir: /var/lib/redis/gitea
        bind:
          - "127.0.0.1"
          - "-::1"
    supersecure1:
      # if true. use tls-port otherwise clustering uses normal port
      replication_use_tls: True
      primary_node:  supersecure0.example.com
      mine_target:   'I@role:supersecure'
      mine_function: fqdn_ip
      require:
        - step_generic_user_cert
        - step_generic_host_cert
      config:
        port: 0
        tls-port: 6488
        dir: /var/lib/redis/supersecure1/
        pidfile: /run/redis/supersecure1.pid
        logfile: /var/log/redis/supersecure1.log
        # use the CA specific file if possible
        tls-ca-cert-file: /etc/ssl/ca-bundle.pem
        tls-cert-file: /etc/step/certs/generic.host.full.pem
        tls-key-file:  /etc/step/certs/generic.host.full.pem
        tls-client-cert-file: /etc/step/certs/generic.user.full.pem
        tls-client-key-file:  /etc/step/certs/generic.user.full.pem
        tls-auth-clients: 'yes'
        tls-replication: 'yes'
        tls-cluster: 'yes'
        tls-protocols: TLSv1.3
        masterauth: superduper
        masteruser: replicator
        user:
        - 'replicator on +@admin ~* >superduper'
        - 'haproxy on -@all +ping >yxorpah'
        - 'reader on +@read ~* >miau'
        - 'god    on +@all  ~* >woof'
        bind:
          - "-::1"
    supersecure2:
      require:
        - step_generic_user_cert
        - step_generic_host_cert
        - redis_services_supersecure1
      config:
        port: 0
        tls-port: 6489
        dir: /var/lib/redis/supersecure2/
        pidfile: /run/redis/supersecure2.pid
        logfile: /var/log/redis/supersecure2.log
        # use the CA specific file if possible
        tls-ca-cert-file: /etc/ssl/ca-bundle.pem
        tls-cert-file: /etc/step/certs/generic.host.full.pem
        tls-key-file:  /etc/step/certs/generic.host.full.pem
        tls-client-cert-file: /etc/step/certs/generic.user.full.pem
        tls-client-key-file:  /etc/step/certs/generic.user.full.pem
        tls-auth-clients: 'yes'
        tls-replication: 'yes'
        tls-cluster: 'yes'
        tls-protocols: TLSv1.3
        masterauth: superduper
        masteruser: replicator
        replicaof: ::1 6488
        user:
        - 'replicator on +@admin ~* >superduper'
        - 'haproxy on -@all +ping >yxorpah'
        - 'reader on +@read ~* >miau'
        - 'god    on +@all  ~* >woof'
        bind:
          - "-::1"


#
# example
#
{%- from 'helpers/radieschen.sls' import sentinel_default_acls, redis_default_acls, tls_cert_dependencies, redis_default_settings_with_tls, sentinel_auth_config, redis_sentinel_auth_config %}

{%- set default_port=6379 %}
{%- set default_tls_port=6380 %}

{%- set ca_cert="/etc/ssl/ca-bundle.pem" %}


{%- set cluster_name = "production-valkey" %}
{%- set cluster_role = "I@role:" ~ cluster_name %}
{%- set cluster_address_mine_function = "fqdn_ip" %}

{%- set replication_key    = cluster_name ~ "/replicator"  %}
{%- set sentinel_key       = cluster_name ~ "/sentinel"    %}
{%- set redis_sentinel_key = cluster_name ~ "/redis_sentinel"    %}
{%- set healthcheck_key    = cluster_name ~ "/healthcheck" %}
{%- set readonly_key       = cluster_name ~ "/readonly"    %}

redis:
  redis_implementation: valkey
  use_sentinel: True
  primary_node:  production0.valkey.example.com
  mine_target:   {{ cluster_role }}
  mine_function: {{ cluster_address_mine_function }}
  sentinel_users:
{{ sentinel_default_acls(sentinel_key=sentinel_key) }}
  sentinel_global_config:
{{ sentinel_auth_config(sentinel_key=sentinel_key) }}
  instances:
    default:
      require:
{{ tls_cert_dependencies() }}
      replication_use_tls: True
      sentinel_config:
{{ redis_sentinel_auth_config(sentinel_key=redis_sentinel_key) }}
      config:
{{ redis_default_settings_with_tls(tls_ca_cert=ca_cert, tls_port=default_tls_port, non_tls_port=default_port, tls_client_auth="'optional'") }}
      user:
{{ redis_default_acls(replication_key=replication_key, healthcheck_key=healthcheck_key, sentinel_key=redis_sentinel_key) }}
      - 'readonly on +@read ~* >{{ readonly_key | gopass(quoted=False) }}'